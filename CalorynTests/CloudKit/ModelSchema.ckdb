DEFINE SCHEMA

    RECORD TYPE CD_DailyGoalSnapshot (
        CD_baseCalorieTarget      INT64 QUERYABLE SORTABLE,
        CD_calculationModeRaw     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_dayKey                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_effectiveCalorieTarget INT64 QUERYABLE SORTABLE,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goalRevisionID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goalRevisionUpdatedAt  TIMESTAMP QUERYABLE SORTABLE,
        CD_healthAdjustment       INT64 QUERYABLE SORTABLE,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isManualTarget         INT64 QUERYABLE SORTABLE,
        CD_updatedAt              TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_FoodItem (
        CD_addedSugarsPer100g         DOUBLE QUERYABLE SORTABLE,
        CD_alcoholPer100g             DOUBLE QUERYABLE SORTABLE,
        CD_barcode                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_brand                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_caloriesPer100g            DOUBLE QUERYABLE SORTABLE,
        CD_carbsPer100g               DOUBLE QUERYABLE SORTABLE,
        CD_caseinPer100g              DOUBLE QUERYABLE SORTABLE,
        CD_categoryTagsRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cholesterolPer100g         DOUBLE QUERYABLE SORTABLE,
        CD_dataSourceRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_defaultServingG            DOUBLE QUERYABLE SORTABLE,
        CD_entityName                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fatPer100g                 DOUBLE QUERYABLE SORTABLE,
        CD_fiberPer100g               DOUBLE QUERYABLE SORTABLE,
        CD_fieldOriginsRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fructosePer100g            DOUBLE QUERYABLE SORTABLE,
        CD_glucosePer100g             DOUBLE QUERYABLE SORTABLE,
        CD_id                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_insolubleFiberPer100g      DOUBLE QUERYABLE SORTABLE,
        CD_isCustom                   INT64 QUERYABLE SORTABLE,
        CD_isPinnedRaw                INT64 QUERYABLE SORTABLE,
        CD_isRecipe                   INT64 QUERYABLE SORTABLE,
        CD_lactosePer100g             DOUBLE QUERYABLE SORTABLE,
        CD_lastUsed                   TIMESTAMP QUERYABLE SORTABLE,
        CD_lookupProviderRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_maltodextrinsPer100g       DOUBLE QUERYABLE SORTABLE,
        CD_maltosePer100g             DOUBLE QUERYABLE SORTABLE,
        CD_monounsaturatedFatPer100g  DOUBLE QUERYABLE SORTABLE,
        CD_name                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_nutriscoreGrade            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_nutritionCompletenessRaw   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_omega3FatPer100g           DOUBLE QUERYABLE SORTABLE,
        CD_omega6FatPer100g           DOUBLE QUERYABLE SORTABLE,
        CD_omega9FatPer100g           DOUBLE QUERYABLE SORTABLE,
        CD_pinnedAt                   TIMESTAMP QUERYABLE SORTABLE,
        CD_polyolsPer100g             DOUBLE QUERYABLE SORTABLE,
        CD_polyunsaturatedFatPer100g  DOUBLE QUERYABLE SORTABLE,
        CD_produceKindRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_proteinPer100g             DOUBLE QUERYABLE SORTABLE,
        CD_providerProductIdentityRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_recoveredByFallbackRaw     INT64 QUERYABLE SORTABLE,
        CD_saltPer100g                DOUBLE QUERYABLE SORTABLE,
        CD_saturatedFatPer100g        DOUBLE QUERYABLE SORTABLE,
        CD_serumProteinsPer100g       DOUBLE QUERYABLE SORTABLE,
        CD_servingDescription         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sodiumPer100g              DOUBLE QUERYABLE SORTABLE,
        CD_solubleFiberPer100g        DOUBLE QUERYABLE SORTABLE,
        CD_starchPer100g              DOUBLE QUERYABLE SORTABLE,
        CD_sucrosePer100g             DOUBLE QUERYABLE SORTABLE,
        CD_sugarsPer100g              DOUBLE QUERYABLE SORTABLE,
        CD_transFatPer100g            DOUBLE QUERYABLE SORTABLE,
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_FoodLogEntry (
        CD_addedSugarsG                     DOUBLE QUERYABLE SORTABLE,
        CD_alcoholG                         DOUBLE QUERYABLE SORTABLE,
        CD_calories                         DOUBLE QUERYABLE SORTABLE,
        CD_carbsG                           DOUBLE QUERYABLE SORTABLE,
        CD_caseinG                          DOUBLE QUERYABLE SORTABLE,
        CD_cholesterolG                     DOUBLE QUERYABLE SORTABLE,
        CD_createdAt                        TIMESTAMP QUERYABLE SORTABLE,
        CD_dataSourceSnapshotRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_date                             TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fatG                             DOUBLE QUERYABLE SORTABLE,
        CD_fiberG                           DOUBLE QUERYABLE SORTABLE,
        CD_foodItem                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_foodName                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fructoseG                        DOUBLE QUERYABLE SORTABLE,
        CD_glucoseG                         DOUBLE QUERYABLE SORTABLE,
        CD_id                               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_insolubleFiberG                  DOUBLE QUERYABLE SORTABLE,
        CD_lactoseG                         DOUBLE QUERYABLE SORTABLE,
        CD_lookupProviderSnapshotRaw        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_maltodextrinsG                   DOUBLE QUERYABLE SORTABLE,
        CD_maltoseG                         DOUBLE QUERYABLE SORTABLE,
        CD_mealType                         BYTES QUERYABLE SORTABLE,
        CD_monounsaturatedFatG              DOUBLE QUERYABLE SORTABLE,
        CD_nutriscoreGradeSnapshot          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_nutritionCompletenessSnapshotRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_omega3FatG                       DOUBLE QUERYABLE SORTABLE,
        CD_omega6FatG                       DOUBLE QUERYABLE SORTABLE,
        CD_omega9FatG                       DOUBLE QUERYABLE SORTABLE,
        CD_polyolsG                         DOUBLE QUERYABLE SORTABLE,
        CD_polyunsaturatedFatG              DOUBLE QUERYABLE SORTABLE,
        CD_portionGrams                     DOUBLE QUERYABLE SORTABLE,
        CD_produceItemsSnapshotRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_produceKindSnapshotRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_proteinG                         DOUBLE QUERYABLE SORTABLE,
        CD_recoveredByFallbackSnapshotRaw   INT64 QUERYABLE SORTABLE,
        CD_replicationItemIndex             INT64 QUERYABLE SORTABLE,
        CD_replicationOperationID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_replicationPlanFingerprint       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_saltG                            DOUBLE QUERYABLE SORTABLE,
        CD_saturatedFatG                    DOUBLE QUERYABLE SORTABLE,
        CD_serumProteinsG                   DOUBLE QUERYABLE SORTABLE,
        CD_snackIndex                       INT64 QUERYABLE SORTABLE,
        CD_sodiumG                          DOUBLE QUERYABLE SORTABLE,
        CD_solubleFiberG                    DOUBLE QUERYABLE SORTABLE,
        CD_starchG                          DOUBLE QUERYABLE SORTABLE,
        CD_sucroseG                         DOUBLE QUERYABLE SORTABLE,
        CD_sugarsG                          DOUBLE QUERYABLE SORTABLE,
        CD_transFatG                        DOUBLE QUERYABLE SORTABLE,
        "___createTime"                     TIMESTAMP,
        "___createdBy"                      REFERENCE,
        "___etag"                           STRING,
        "___modTime"                        TIMESTAMP,
        "___modifiedBy"                     REFERENCE,
        "___recordID"                       REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MealTemplate (
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_creationFingerprint  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_creationOperationID  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_defaultMealRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_defaultSnackIndexRaw INT64 QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt            TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MealTemplateItem (
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_snapshotData         BYTES QUERYABLE SORTABLE,
        CD_snapshotData_ckAsset ASSET,
        CD_sortOrder            INT64 QUERYABLE SORTABLE,
        CD_sourceFoodID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_template             STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_RecipeIngredient (
        CD_addedSugarsPer100g        DOUBLE QUERYABLE SORTABLE,
        CD_alcoholPer100g            DOUBLE QUERYABLE SORTABLE,
        CD_brand                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_caloriesPer100g           DOUBLE QUERYABLE SORTABLE,
        CD_carbsPer100g              DOUBLE QUERYABLE SORTABLE,
        CD_caseinPer100g             DOUBLE QUERYABLE SORTABLE,
        CD_cholesterolPer100g        DOUBLE QUERYABLE SORTABLE,
        CD_createdAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_dataSourceRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fatPer100g                DOUBLE QUERYABLE SORTABLE,
        CD_fiberPer100g              DOUBLE QUERYABLE SORTABLE,
        CD_fructosePer100g           DOUBLE QUERYABLE SORTABLE,
        CD_glucosePer100g            DOUBLE QUERYABLE SORTABLE,
        CD_id                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_insolubleFiberPer100g     DOUBLE QUERYABLE SORTABLE,
        CD_lactosePer100g            DOUBLE QUERYABLE SORTABLE,
        CD_lookupProviderRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_maltodextrinsPer100g      DOUBLE QUERYABLE SORTABLE,
        CD_maltosePer100g            DOUBLE QUERYABLE SORTABLE,
        CD_monounsaturatedFatPer100g DOUBLE QUERYABLE SORTABLE,
        CD_name                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_nutritionCompletenessRaw  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_omega3FatPer100g          DOUBLE QUERYABLE SORTABLE,
        CD_omega6FatPer100g          DOUBLE QUERYABLE SORTABLE,
        CD_omega9FatPer100g          DOUBLE QUERYABLE SORTABLE,
        CD_polyolsPer100g            DOUBLE QUERYABLE SORTABLE,
        CD_polyunsaturatedFatPer100g DOUBLE QUERYABLE SORTABLE,
        CD_portionGrams              DOUBLE QUERYABLE SORTABLE,
        CD_produceKindRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_proteinPer100g            DOUBLE QUERYABLE SORTABLE,
        CD_recipe                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_recoveredByFallbackRaw    INT64 QUERYABLE SORTABLE,
        CD_saltPer100g               DOUBLE QUERYABLE SORTABLE,
        CD_saturatedFatPer100g       DOUBLE QUERYABLE SORTABLE,
        CD_serumProteinsPer100g      DOUBLE QUERYABLE SORTABLE,
        CD_sodiumPer100g             DOUBLE QUERYABLE SORTABLE,
        CD_solubleFiberPer100g       DOUBLE QUERYABLE SORTABLE,
        CD_sortOrder                 INT64 QUERYABLE SORTABLE,
        CD_starchPer100g             DOUBLE QUERYABLE SORTABLE,
        CD_sucrosePer100g            DOUBLE QUERYABLE SORTABLE,
        CD_sugarsPer100g             DOUBLE QUERYABLE SORTABLE,
        CD_transFatPer100g           DOUBLE QUERYABLE SORTABLE,
        "___createTime"              TIMESTAMP,
        "___createdBy"               REFERENCE,
        "___etag"                    STRING,
        "___modTime"                 TIMESTAMP,
        "___modifiedBy"              REFERENCE,
        "___recordID"                REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UserProfile (
        CD_activityLevel            BYTES QUERYABLE SORTABLE,
        CD_addedSugarsGoalEnabled   INT64 QUERYABLE SORTABLE,
        CD_addedSugarsGoalKindRaw   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_addedSugarsTargetG       DOUBLE QUERYABLE SORTABLE,
        CD_age                      INT64 QUERYABLE SORTABLE,
        CD_alcoholGoalEnabled       INT64 QUERYABLE SORTABLE,
        CD_alcoholGoalKindRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_alcoholTargetG           DOUBLE QUERYABLE SORTABLE,
        CD_bmr                      DOUBLE QUERYABLE SORTABLE,
        CD_calorieDeficit           DOUBLE QUERYABLE SORTABLE,
        CD_carbGoalKindRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_carbTargetG              DOUBLE QUERYABLE SORTABLE,
        CD_cholesterolGoalEnabled   INT64 QUERYABLE SORTABLE,
        CD_cholesterolGoalKindRaw   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cholesterolTargetG       DOUBLE QUERYABLE SORTABLE,
        CD_createdAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_dailyCalorieTarget       INT64 QUERYABLE SORTABLE,
        CD_energyCalculationModeRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fatGoalKindRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fatTargetG               DOUBLE QUERYABLE SORTABLE,
        CD_fiberGoalEnabled         INT64 QUERYABLE SORTABLE,
        CD_fiberGoalKindRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fiberTargetG             DOUBLE QUERYABLE SORTABLE,
        CD_heightCm                 DOUBLE QUERYABLE SORTABLE,
        CD_id                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_manualOverride           INT64 QUERYABLE SORTABLE,
        CD_proteinGoalKindRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_proteinTargetG           DOUBLE QUERYABLE SORTABLE,
        CD_saturatedFatGoalEnabled  INT64 QUERYABLE SORTABLE,
        CD_saturatedFatGoalKindRaw  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_saturatedFatTargetG      DOUBLE QUERYABLE SORTABLE,
        CD_sex                      BYTES QUERYABLE SORTABLE,
        CD_sodiumGoalEnabled        INT64 QUERYABLE SORTABLE,
        CD_sodiumGoalKindRaw        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sodiumTargetG            DOUBLE QUERYABLE SORTABLE,
        CD_sugarsGoalEnabled        INT64 QUERYABLE SORTABLE,
        CD_sugarsGoalKindRaw        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sugarsTargetG            DOUBLE QUERYABLE SORTABLE,
        CD_tdee                     DOUBLE QUERYABLE SORTABLE,
        CD_updatedAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_weightKg                 DOUBLE QUERYABLE SORTABLE,
        "___createTime"             TIMESTAMP,
        "___createdBy"              REFERENCE,
        "___etag"                   STRING,
        "___modTime"                TIMESTAMP,
        "___modifiedBy"             REFERENCE,
        "___recordID"               REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
